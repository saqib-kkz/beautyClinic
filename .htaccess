RewriteEngine On
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ /public/$1 [L,QSA]

# Security: Block access to sensitive files and directories
<Files ".env">
    Order allow,deny
    Deny from all
</Files>

<Files "composer.json">
    Order allow,deny
    Deny from all
</Files>

<Files "composer.lock">
    Order allow,deny
    Deny from all
</Files>

<Files "package.json">
    Order allow,deny
    Deny from all
</Files>

<Files ".gitignore">
    Order allow,deny
    Deny from all
</Files>

# Block access to Laravel directories
<IfModule mod_alias.c>
    RedirectMatch 403 ^/app/
    RedirectMatch 403 ^/bootstrap/
    RedirectMatch 403 ^/config/
    RedirectMatch 403 ^/database/
    RedirectMatch 403 ^/resources/
    RedirectMatch 403 ^/routes/
    RedirectMatch 403 ^/storage/
    RedirectMatch 403 ^/tests/
    RedirectMatch 403 ^/vendor/
</IfModule>

# Disable directory browsing
Options -Indexes

# Block access to hidden files (starting with dot)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>